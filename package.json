{
  "name": "agentnexlify-quality-gates",
  "private": true,
  "scripts": {
    "check": "npm run check:quick",
    "check:quick": "npm run agent-system:check && npm run check:project && npm run sync-widget:check && npm run check:codex-orchestration",
    "check:full": "npm run check:quick && npm run build && npm run test",
    "check:agent": "npm run agent-system:check",
    "check:project": "python scripts/check_project_invariants.py",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -m pytest tests/ -q",
    "test:frontend": "npm --prefix frontend run test -- --run",
    "smoke": "npm run smoke:public",
    "sync-widget": "python scripts/sync_widget_assets.py",
    "sync-widget:check": "python scripts/sync_widget_assets.py --check",
    "agent-system:check": "python scripts/check_agent_system.py",
    "claude:2.1.98": "npx -y @anthropic-ai/claude-code@2.1.98",
    "claude:noflicker": "cross-env CLAUDE_CODE_NO_FLICKER=1 npx -y @anthropic-ai/claude-code@2.1.98",
    "marketing-addon:check": "python scripts/check_marketing_addon_rollout.py",
    "stripe-pricing:check": "python scripts/check_stripe_pricing_config.py",
    "smoke:public": "python scripts/public_smoke.py",
    "test:e2e": "playwright test",
    "check:test-local-refs": "python3 scripts/check_test_local_refs.py",
    "lint:test-quality": "eslint --no-error-on-unmatched-pattern --config eslint.test-quality.config.cjs \"**/*.test.{js,jsx,ts,tsx}\" \"**/*.spec.{js,jsx,ts,tsx}\" \"**/__tests__/**/*.{js,jsx,ts,tsx}\"",
    "lint:test-quality:staged": "node scripts/lint-test-quality-staged.cjs",
    "coverage:changed-lines": "python3 scripts/check_changed_lines_coverage.py --compare-branch origin/main --python-report coverage-python.xml --js-report frontend/coverage/lcov.info --js-report demo-platform/coverage/lcov.info --js-report coverage/lcov.info",
    "check:codex-orchestration": "python scripts/check_codex_orchestration_adoption.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@typescript-eslint/parser": "^8.46.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.37.0"
  }
}
