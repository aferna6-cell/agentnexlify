{
  "name": "agentnexlify-quality-gates",
  "private": true,
  "scripts": {
    "check": "npm run check:quick",
    "check:quick": "npm run team:check && npm run agent-system:check && npm run check:instruction-budget && npm run check:skills && npm run sync-skills:check && npm run skills:eval && npm run eval:agent-routing && npm run check:project && npm run sync-widget:check && npm run check:codex-orchestration",
    "check:full": "npm run check:quick && npm run build && npm run test",
    "check:local-release": "npm run check:quick && npm run build && npm run test:backend:focused && npm run test:frontend",
    "check:agent": "npm run agent-system:check",
    "team:check": "node scripts/run_python.cjs scripts/check_team_protocol.py",
    "team:preflight": "node scripts/run_python.cjs scripts/teamctl.py preflight",
    "team:status": "node scripts/run_python.cjs scripts/teamctl.py status",
    "check:instruction-budget": "node scripts/run_python.cjs scripts/check_instruction_budget.py",
    "check:skills": "node scripts/run_python.cjs scripts/check_skills.py",
    "check:project": "node scripts/run_python.cjs scripts/check_project_invariants.py",
    "agent-config:scan": "npx -y ecc-agentshield@1.4.0 scan --path . --baseline config/agentshield-baseline.json --gate --min-severity high",
    "agent-config:scan:report": "npx -y ecc-agentshield@1.4.0 scan --path .",
    "agent-config:scan:baseline": "npx -y ecc-agentshield@1.4.0 scan --path . --save-baseline config/agentshield-baseline.json --min-severity high",
    "agent-config:scan:fix": "npx -y ecc-agentshield@1.4.0 scan --path . --fix",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "node scripts/run_python.cjs -m uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/run_python.cjs -m pytest tests/ -q",
    "test:backend:focused": "node scripts/run_python.cjs -m pytest tests/test_autopilot_orchestration.py tests/test_local_seo_parsers.py -q",
    "test:frontend": "npm --prefix frontend run test -- --run",
    "smoke": "npm run smoke:public",
    "kb:lint": "node scripts/run_python.cjs scripts/kb/kb-lint.py --fix-index",
    "kb:health": "node scripts/run_python.cjs scripts/kb/kb-health.py",
    "sync-widget": "node scripts/run_python.cjs scripts/sync_widget_assets.py",
    "sync-widget:check": "node scripts/run_python.cjs scripts/sync_widget_assets.py --check",
    "sync-skills": "node scripts/run_python.cjs scripts/sync_skills.py --write",
    "sync-skills:check": "node scripts/run_python.cjs scripts/sync_skills.py",
    "skills:eval": "node scripts/run_python.cjs scripts/run_skill_evals.py",
    "eval:agent-routing": "node scripts/run_python.cjs scripts/evaluate_agent_routing.py --check",
    "agent-system:check": "node scripts/run_python.cjs scripts/check_agent_system.py",
    "autopilot:dry-run": "node scripts/run_python.cjs scripts/autopilot/classify_and_dispatch.py --dry-run",
    "autopilot:dry-run:issue": "node scripts/run_python.cjs scripts/autopilot/classify_and_dispatch.py --dry-run --issue",
    "claude:2.1.98": "npx -y @anthropic-ai/claude-code@2.1.98",
    "claude:noflicker": "cross-env CLAUDE_CODE_NO_FLICKER=1 npx -y @anthropic-ai/claude-code@2.1.98",
    "marketing-addon:check": "node scripts/run_python.cjs scripts/check_marketing_addon_rollout.py",
    "stripe-pricing:check": "node scripts/run_python.cjs scripts/check_stripe_pricing_config.py",
    "smoke:public": "node scripts/run_python.cjs scripts/public_smoke.py",
    "test:e2e": "playwright test",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "check:test-local-refs": "node scripts/run_python.cjs scripts/check_test_local_refs.py",
    "lint:test-quality": "eslint --no-error-on-unmatched-pattern --config eslint.test-quality.config.cjs \"**/*.test.{js,jsx,ts,tsx}\" \"**/*.spec.{js,jsx,ts,tsx}\" \"**/__tests__/**/*.{js,jsx,ts,tsx}\"",
    "lint:test-quality:staged": "node scripts/lint-test-quality-staged.cjs",
    "coverage:changed-lines": "node scripts/run_python.cjs scripts/check_changed_lines_coverage.py --compare-branch origin/main --python-report coverage-python.xml --js-report frontend/coverage/lcov.info --js-report demo-platform/coverage/lcov.info --js-report coverage/lcov.info",
    "check:codex-orchestration": "node scripts/run_python.cjs scripts/check_codex_orchestration_adoption.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/parser": "^8.69.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.9.1"
  }
}
