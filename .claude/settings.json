{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/log-commands.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/require-tests-for-pr.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/post-edit-check.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-lint.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/run-tests-after-edit.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/notify-complete.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/calm-on-failure.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/pre-compact-save.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"CAVEMAN MODE ACTIVE. Use caveman skill rules: drop articles/filler/pleasantries, fragments OK, short synonyms, technical terms exact, code unchanged. Pattern: [thing] [action] [reason]. [next step].\"}}'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"ULTRAPLAN + ULTRATHINK: For every question or task, use extended thinking. Break complex problems into subproblems. Consider 2-3 approaches before picking one. Think about edge cases, failure modes, and second-order effects. Plan before acting. If a task touches 2+ files, enter plan mode first. Never skip the thinking step.\"}}'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"NO ASSUMPTIONS RULE: When a task is ambiguous, has multiple valid interpretations, or could cause destructive changes — ASK the user before proceeding. Never guess at: which files to delete, which branch to target, which env to deploy to, what the user meant by vague instructions, schema changes that could break production. If confidence in the correct interpretation is below 80%, ask a clarifying question. One question now saves hours of wrong-direction work.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/confidence-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-commit.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
