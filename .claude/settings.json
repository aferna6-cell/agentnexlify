{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list*)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(cat /dev/stdin*)",
      "mcp__context7__*",
      "mcp__playwright__*",
      "mcp__deepwiki__*",
      "mcp__supabase__*"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.gcp/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(/etc/**)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(*> /dev/*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(telnet:*)",
      "Bash(bash -i*)",
      "Bash(sh -i*)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/log-commands.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/pre-commit-review.sh"
          },
          {
            "type": "agent",
            "prompt": "Review all unpushed commits for this branch. Run: git log --oneline origin/main..HEAD and git diff origin/main..HEAD. Check for: (1) missing tenant isolation in DB queries (leads/conversations use client_id not tenant_id), (2) route shadowing (static routes must register before param routes), (3) unawaited async calls, (4) bare except:pass without logging, (5) security issues (secret leakage, XSS, missing auth). Output BLOCK with reason if critical issues found. Output PASS if clean.",
            "if": "Bash(git push*)",
            "timeout": 120,
            "model": "claude-haiku-4-5-20251001",
            "statusMessage": "Reviewing unpushed commits..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/protect-files.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/validate-skill.sh",
            "statusMessage": "Validating skill template..."
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/require-tests-for-pr.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/route-to-agent-browser.sh",
            "statusMessage": "Routing to agent-browser (fallback: native fetch)..."
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "knowledge-base/wiki",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/kb-viewer-sync.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "knowledge-base/raw",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"FileChanged\",\"additionalContext\":\"New raw source added to knowledge-base/raw/. Run /kb-compile to update wiki articles, or queue it for the next session. Check PENDING.md for unprocessed sources.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/kb-viewer-sync.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/post-edit-check.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-lint.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/run-tests-after-edit.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/reference-design.sh",
            "timeout": 5
          },
          {
            "type": "agent",
            "prompt": "A security-critical file was just modified. Read the changed file and scan for: (1) auth bypass \u2014 missing verify_tenant or JWT validation, (2) tenant data leakage \u2014 queries without tenant_id/client_id filter, (3) secret leakage in logs or responses, (4) Stripe webhook missing signature verification, (5) missing input validation on request bodies. Report findings with line numbers. Exit code 2 if critical vulnerability found.",
            "if": "Edit(backend/routers/auth.py)|Edit(backend/routers/stripe_webhooks.py)|Edit(backend/routers/billing.py)|Edit(backend/routers/client_portal.py)|Edit(backend/dependencies.py)|Write(backend/routers/auth.py)|Write(backend/routers/stripe_webhooks.py)|Write(backend/routers/billing.py)|Write(backend/routers/client_portal.py)|Write(backend/dependencies.py)",
            "timeout": 90,
            "model": "claude-haiku-4-5-20251001",
            "statusMessage": "Security scanning modified auth/payment file..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/notify-complete.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/calm-on-failure.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/pre-compact-save.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/ultrathink-trigger.sh",
            "timeout": 5,
            "statusMessage": "Checking complexity..."
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/kb-first-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/message-counter.sh",
            "timeout": 5,
            "statusMessage": "Checking message count..."
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/context-budget.sh",
            "timeout": 5,
            "statusMessage": "Checking context budget..."
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/invoke-opus-47-features.sh",
            "timeout": 5,
            "statusMessage": "Reminding Opus 4.7 features..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/task-completed-veto.sh",
            "timeout": 60,
            "statusMessage": "Verifying build before completion..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/log-compaction.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/cleanup-worktree.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-commit.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/notify-stop.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true,
    "data@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": true,
    "amplitude@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": true,
    "pagerduty@claude-plugins-official": true,
    "mintlify@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "stripe@claude-plugins-official": true,
    "brand-voice@knowledge-work-plugins": true,
    "marketing@knowledge-work-plugins": true,
    "sales@knowledge-work-plugins": true,
    "legal@knowledge-work-plugins": true,
    "finance@knowledge-work-plugins": true,
    "productivity@knowledge-work-plugins": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa",
        "**/id_ed25519"
      ]
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 400000
}
