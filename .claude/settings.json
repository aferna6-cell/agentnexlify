{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/log-commands.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/require-tests-for-pr.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/post-edit-check.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-lint.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/run-tests-after-edit.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/notify-complete.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/calm-on-failure.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/pre-compact-save.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claude-hooks/auto-commit.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
