# Staging-only M9.4 bakeoff image. Do not copy these extras into backend/Dockerfile.
# Production API does not load the planner catalog at startup.
FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/ backend/
COPY scripts/run_m9_planner_bakeoff.py scripts/run_m9_planner_bakeoff.py
COPY agent-service/src/agent-os/actions/action_manifest.json agent-service/src/agent-os/actions/action_manifest.json
# Fail the build if either catalog path is missing. Railway has shipped
# backend-only images that crash on TOOL_CATALOG import.
RUN test -f agent-service/src/agent-os/actions/action_manifest.json \
    && test -f backend/services/os_workflows/action_manifest.json

ENV PYTHONUNBUFFERED=1
ENV LLM_TRACE_ENABLED=0

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Stay idle unless an operator explicitly overrides the start command.
# A live bakeoff is paid and must never restart from a deploy/push.
CMD ["python", "-c", "print('m9-bakeoff-runner idle')"]
