.env
__pycache__/
*.pyc
.venv/
*.egg-info/
.claude/state/
dist/
build/
.DS_Store
node_modules/
test-results/
playwright-report/
*.log
mutants/
coverage/

# Agent communication files (ephemeral, per-session)
.claude/agent-comms/*.md
.claude/agent-comms/*.json
!.claude/agent-comms/.gitkeep
!.claude/agent-comms/README.md
!.claude/agent-comms/backlog.md
!.claude/agent-comms/loop-prompt.md

# Auto-generated execution logs from scheduled routines
docs/daily-logs/auto-morning-*.log
docs/daily-logs/auto-evening-*.log

# Windows batch wrappers (generated by setup script, machine-specific)
scripts/daily/run-morning.bat
scripts/daily/run-evening.bat
.claude/command-log.txt
.claude/worktrees/
.gitnexus
.mcp.json
.env
# Auto-generated by scripts/managed_agents/provision.py — contains live
# Claude Managed Agent IDs scoped to the developer's org. Do not commit.
.env.managed_agents
# Ephemeral local scratchpad: codebase-reviewer event logs, ad-hoc
# inspection output, etc. Never committed.
scratch/
graphify-out/cache/
graphify-out/graph.json
graphify-out/manifest.json
supabase/.temp/

# kb-compile ephemeral scratch — embedding temp scripts + voyage response dumps.
# Safe to ignore; regenerated per compile run.
knowledge-base/_embed_tmp.py
knowledge-base/_embeddings_*.json

# Obsidian sync state (contains local vault path, machine-specific)
knowledge-base/.obsidian-sync-state.json
CLAUDE.local.md

# OpenClaw migration — contains secrets
.openclaw-migration/morpheus/polymarket-bot-.env

# autoskills installs mirror dirs for each supported IDE. We only use
# Claude Code, so only .agents/ (canonical storage) + .claude/skills/
# (symlinked from .agents/) are committed. Next `npx autoskills` run
# will recreate these locally — safe to leave untracked.
.augment/
.codebuddy/
.continue/
.junie/
.kiro/
.openclaw-migration/openclaw.env
.openclaw-migration/morpheus/morpheus-sync-.env.example

# Obsidian local vault config (when repo opened as Obsidian vault)
.obsidian/
