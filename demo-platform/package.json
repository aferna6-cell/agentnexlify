{
  "name": "agentnexlify-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "start": "bash start.sh",
    "build": "vite build",
    "api": "cd server && python3 app.py",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
