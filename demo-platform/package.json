{
  "name": "agentnexlify-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "start": "bash start.sh",
    "build": "vite build",
    "api": "cd server && python3 app.py",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
