# AgentNexLiFy — .env.example (regenerated 2026-04-15)
# Copy to .env and fill in. Real .env is gitignored.
# Keys match pydantic-settings Settings class in backend/config.py.

# ── Core ────────────────────────────────────────────────────────────
# Production MUST set API_SECRET_KEY. Dev fallback is insecure + deterministic.
API_SECRET_KEY=
# Optional — falls back to API_SECRET_KEY if unset.
JWT_SECRET_KEY=
# Optional — isolates /api/v1/admin/* access.
ADMIN_API_SECRET_KEY=
BILLING_SECRET=

# ── Supabase (REQUIRED in production) ───────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Current purchasable plans (2026-06-15 repricing) + annual prepay (2026-08-25)
STRIPE_PRICE_CHATBOT_MONTHLY=
STRIPE_PRICE_AGENT_OS_MONTHLY=
STRIPE_PRICE_CHATBOT_ANNUAL=
STRIPE_PRICE_AGENT_OS_ANNUAL=
STRIPE_PRICE_AGENT_OS_MANAGED_MONTHLY=
STRIPE_PRICE_AGENT_OS_MANAGED_SETUP=
STRIPE_PRICE_VOICE_ADDON_MONTHLY=
STRIPE_PRICE_USAGE_PACK=
# Legacy plan prices (grandfathered contracts only — do not use for new signups)
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_AUTOPILOT_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_MARKETING_ADDON_MONTHLY=

# ── Email / SMS ─────────────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── URLs + CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=
WIDGET_ALLOWED_ORIGINS=*

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=

# ── Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Google Places (lead-gen CLI: scripts/leadgen) ───────────────────
GOOGLE_PLACES_API_KEY=

# ── Optional integrations ───────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VOYAGE_API_KEY=
OPENROUTER_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=

# ── Agent OS v2 engine (agent-service) ──────────────────────────────
# Activates the v2 (8-department) TypeScript engine in agent-service/.
# UNSET = backend silently falls back to the legacy Python orchestrator
# (agent_sdk_client.is_enabled() gates on AGENT_SERVICE_URL). In prod, point
# at the Railway private URL: http://agent-service.railway.internal:3100
AGENT_SERVICE_URL=
# Shared secret; must match AGENT_SERVICE_TOKEN set on the agent-service.
AGENT_SERVICE_TOKEN=

# ── Slack agent team (operator surface) ─────────────────────────────
# Internal Slack bot roster (chief/engineer/schema/growth/support/ops).
# All three required together — any one missing => /api/v1/slack/events 503s.
# Setup: docs/slack-agent-team.md
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Optional. Empty => anyone in the allowed workspace can talk to the agents.
SLACK_ALLOWED_USER_IDS=
SLACK_AGENTS_MODEL=claude-sonnet-5
SLACK_AGENTS_MAX_TOKENS=700
SLACK_AGENTS_HISTORY_MESSAGES=12

# ── MCP (for .mcp.example.json → .mcp.json) ─────────────────────────
SUPABASE_ACCESS_TOKEN=

# ── Dev-only ────────────────────────────────────────────────────────
# TESTING=1   # disables automation loop on boot
