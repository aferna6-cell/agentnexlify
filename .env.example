ANTHROPIC_API_KEY=your_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
# Twilio — required for missed-call text-back automation
# Get credentials from https://console.twilio.com
# TWILIO_PHONE_NUMBER must be E.164 format, e.g. +15125551234
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
CALENDLY_API_KEY=optional_for_later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=optional_for_later
SMTP_PASS=optional_for_later
WIDGET_ALLOWED_ORIGINS=*
API_SECRET_KEY=generate_a_random_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=http://localhost:5173
# Google Calendar integration (OAuth2)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agentnexlify-production.up.railway.app/api/v1/integrations/google/callback
