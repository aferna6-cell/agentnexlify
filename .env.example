ANTHROPIC_API_KEY=your_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
# Twilio — required for missed-call text-back automation
# Get credentials from https://console.twilio.com
# TWILIO_PHONE_NUMBER must be E.164 format, e.g. +15125551234
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
CALENDLY_API_KEY=optional_for_later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=optional_for_later
SMTP_PASS=optional_for_later
WIDGET_ALLOWED_ORIGINS=*
# Optional comma-separated backend CORS override. Leave blank to reuse
# WIDGET_ALLOWED_ORIGINS; public widget installs often require "*".
CORS_ALLOWED_ORIGINS=
# CRITICAL: Must be a fixed value in production, not the random default.
# With 4 uvicorn workers, a random key means JWTs break across workers.
API_SECRET_KEY=replace_with_strong_random_secret_key
# Strongly recommended: set dedicated keys to isolate blast radius.
JWT_SECRET_KEY=replace_with_strong_jwt_secret
ADMIN_API_SECRET_KEY=replace_with_strong_admin_secret
# Keep disabled unless you intentionally need old lead-only unsubscribe links.
ALLOW_LEGACY_UNSUBSCRIBE_SIGNATURES=false
# Keep disabled unless you intentionally need old non-expiring appointment links.
ALLOW_LEGACY_RESCHEDULE_TOKENS=false
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=https://agentnexlify.vercel.app
# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key
# Backend URL for OAuth callbacks
API_URL=https://agentnexlify-production.up.railway.app
# Sentry error monitoring (optional)
SENTRY_DSN=
# Cloudflare website crawler (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Google Calendar integration (OAuth2)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agentnexlify-production.up.railway.app/api/v1/integrations/google/callback
