{
  "schema_version": 2,
  "project": "AgentNexLiFy",
  "description": "AI-powered business automation platform for small businesses. Includes customer-facing AI, automations, an embeddable widget, MCP access, and a multi-agent development system.",
  "updated_at": "2026-04-05",
  "documentation": {
    "primary": "CLAUDE.md",
    "codex_adapter": "AGENTS.md",
    "ai_architecture_audit": "docs/AI_ARCHITECTURE_AUDIT.md",
    "agent_system_plan": "docs/AGENT_SYSTEM_PLAN.md",
    "architecture": "docs/dev-knowledge/architecture-decisions.md",
    "schema_log": "docs/dev-knowledge/schema-log.md",
    "bug_patterns": "docs/dev-knowledge/bug-patterns.md"
  },
  "tech_stack": {
    "backend": "FastAPI (Python 3.11, Pydantic, Supabase Python client)",
    "frontend": "React (Vite, dashboard + marketing/public pages)",
    "database": "Supabase/PostgreSQL with RLS",
    "runtime_ai": "Anthropic Claude API",
    "embeddings": "Voyage AI",
    "email": "Resend",
    "sms": "Twilio",
    "payments": "Stripe",
    "hosting": {
      "backend": "Railway",
      "frontend": "Vercel"
    }
  },
  "directory_map": {
    "backend/": "FastAPI service (main.py, routers/, services/)",
    "frontend/": "React/Vite dashboard and public pages",
    "widget/": "Embeddable chat widget (must mirror frontend/public/widget/)",
    "frontend/public/widget/": "Widget mirror — keep identical to widget/",
    "migrations/": "SQL migrations",
    "docs/dev-knowledge/": "durable engineering memory and research",
    "knowledge-base/": "structured knowledge inputs and compiled wiki outputs",
    ".claude/": "Claude-oriented agents, skills, commands, and hooks",
    ".codex/": "Codex-native repo skills",
    "skills/": "repo-level shared skills",
    "_archive/": "retired code; do not touch unless explicitly requested",
    "landing-page-v2/": "legacy frontend; do not touch unless explicitly requested",
    "public/": "legacy widget/public assets; do not touch unless explicitly requested"
  },
  "critical_rules": [
    "NEVER use `from __future__ import annotations` in FastAPI router files",
    "Always use `client_id` for leads and conversations table queries",
    "Always use `status` for lead status on the leads table",
    "Widget JS in widget/ and frontend/public/widget/ must remain identical",
    "Database schema changes only via numbered migrations in migrations/",
    "NEVER commit .env files or raw secret values",
    "Production uses multi-worker Uvicorn; in-memory state is per-process only",
    "Use dedicated MCP API keys for MCP access; do not use widget API keys for MCP auth"
  ],
  "runtime_ai": {
    "customer_facing_surfaces": [
      "widget chat",
      "tag extraction",
      "conversation categorization",
      "action-item extraction",
      "AI email generation",
