  "critical_rules": [
    "NEVER use `from __future__ import annotations` in FastAPI router files",
    "Always use `client_id` for leads and conversations table queries",
    "Always use `status` for lead status on the leads table",
    "Widget JS in widget/ and frontend/public/widget/ must remain identical",
    "Database schema changes only via numbered migrations in migrations/",
    "NEVER commit .env files or raw secret values",
    "Production uses multi-worker Uvicorn; in-memory state is per-process only",
    "Use dedicated MCP API keys for MCP access; do not use widget API keys for MCP auth"
  ],
