#!/usr/bin/env bash
# AgentNexLiFy pre-push hook
# Blocks push on weak test quality and critical regressions.
# Install: bash scripts/install-hooks.sh

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

echo "Running AgentNexLiFy pre-push checks..."
echo ""

detect_python_bin() {
    if [ -f ".venv313/Scripts/python.exe" ]; then
        echo ".venv313/Scripts/python.exe"
        return 0
    fi
    if [ -f ".venv/Scripts/python.exe" ]; then
        echo ".venv/Scripts/python.exe"
        return 0
    fi
    if command -v python3 >/dev/null 2>&1; then
        echo "python3"
        return 0
    fi
    if command -v python >/dev/null 2>&1; then
        echo "python"
        return 0
    fi
    return 1
}

detect_node_bin() {
    if command -v node >/dev/null 2>&1; then
        echo "node"
        return 0
    fi
    if command -v node.cmd >/dev/null 2>&1; then
        echo "node.cmd"
        return 0
    fi
    return 1
}

detect_npm_bin() {
    if command -v npm >/dev/null 2>&1; then
        echo "npm"
        return 0
    fi
    if command -v npm.cmd >/dev/null 2>&1; then
        echo "npm.cmd"
        return 0
    fi
    return 1
}

PY_BIN="$(detect_python_bin || true)"
NODE_BIN="$(detect_node_bin || true)"
NPM_BIN="$(detect_npm_bin || true)"

# CHECK 1: JS/TS test quality lint
echo -n "Linting JS/TS test quality... "
if [ -z "$NODE_BIN" ] || [ -z "$NPM_BIN" ]; then
    echo -e "${RED}FAILED${NC}"
    echo "  Node.js and npm are required for JS/TS test-quality linting."
    ERRORS=$((ERRORS + 1))
elif "$NPM_BIN" run -s lint:test-quality; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAILED${NC}"
    echo "  JS/TS test-quality lint failed."
    ERRORS=$((ERRORS + 1))
fi

# CHECK 2: Python test quality lint
echo -n "Linting Python test quality... "
if [ -z "$PY_BIN" ]; then
    echo -e "${RED}FAILED${NC}"
    echo "  Python is required for Python test-quality linting."
    ERRORS=$((ERRORS + 1))
elif "$PY_BIN" scripts/lint_python_test_quality.py; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAILED${NC}"
    echo "  Python test-quality lint failed."
    ERRORS=$((ERRORS + 1))
fi

# CHECK 3: Fast critical pytest subset
echo -n "Running fast critical backend tests... "
DEFAULT_FAST_TESTS=(
    tests/test_admin_analytics.py
    tests/test_widget_api.py
    tests/test_marketing_infrastructure.py
    tests/test_stripe_webhook.py
)

if [ -n "${AGENTNEXLIFY_FAST_TESTS:-}" ]; then
    # shellcheck disable=SC2206
    FAST_TESTS=(${AGENTNEXLIFY_FAST_TESTS})
else
    FAST_TESTS=("${DEFAULT_FAST_TESTS[@]}")
fi

if [ -z "$PY_BIN" ]; then
    echo -e "${RED}FAILED${NC}"
    echo "  Python is required to run fast critical tests."
    ERRORS=$((ERRORS + 1))
elif "$PY_BIN" -m pytest -q "${FAST_TESTS[@]}"; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAILED${NC}"
    echo "  Critical pytest subset failed."
    ERRORS=$((ERRORS + 1))
fi

# CHECK 4: Frontend build (skip when no frontend files changed in push range)
echo -n "Checking frontend build... "
if [ ! -d "frontend" ]; then
    echo -e "${YELLOW}SKIPPED (no frontend dir found)${NC}"
else
    # Determine push range: upstream if tracked, else origin/main..HEAD for new branches
    PUSH_RANGE="origin/main..HEAD"
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        PUSH_RANGE='@{u}..HEAD'
    fi
    FE_CHANGED=$(git diff --name-only --diff-filter=ACMR "$PUSH_RANGE" 2>/dev/null | grep -E '^(frontend/|widget/)' || true)
    if [ -z "$FE_CHANGED" ]; then
        echo -e "${GREEN}OK (no frontend files changed)${NC}"
    elif [ -z "$NPM_BIN" ]; then
        echo -e "${RED}FAILED${NC}"
        echo "  npm is required for frontend build checks."
        ERRORS=$((ERRORS + 1))
    elif [ ! -d "frontend/node_modules" ]; then
        echo -e "${YELLOW}SKIPPED (frontend/node_modules missing — run 'npm ci' in frontend first)${NC}"
        WARNINGS=$((WARNINGS + 1))
    elif (cd frontend && "$NPM_BIN" run build --silent 2>/dev/null); then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        echo "  Frontend build failed."
        ERRORS=$((ERRORS + 1))
    fi
fi

# CHECK 5: Scan for dangerous __future__ imports in routers
echo -n "Scanning for __future__ annotations in routers... "
if grep -rn "from __future__ import annotations" backend/routers/ 2>/dev/null | grep -v "^.*:#" | grep -q .; then
    echo -e "${RED}FAILED${NC}"
    echo "  from __future__ import annotations found in router files (breaks FastAPI)."
    grep -rn "from __future__ import annotations" backend/routers/ 2>/dev/null | grep -v "^.*:#"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 6: .env in .gitignore
echo -n "Checking .gitignore includes .env... "
if grep -q "\.env" .gitignore 2>/dev/null; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAILED${NC}"
    echo "  .env is NOT in .gitignore."
    ERRORS=$((ERRORS + 1))
fi

# CHECK 8: Semgrep security scan on changed code files (best-effort; skips gracefully if uvx missing)
echo -n "Running semgrep security scan... "
if ! command -v uvx >/dev/null 2>&1; then
    echo -e "${YELLOW}SKIPPED (uvx not found; install 'uv' to enable)${NC}"
else
    UPSTREAM_RANGE="HEAD"
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        UPSTREAM_RANGE='@{u}..HEAD'
    fi
    CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR "$UPSTREAM_RANGE" 2>/dev/null | grep -E '\.(py|js|jsx|ts|tsx)$' || true)
    if [ -z "$CHANGED_FILES" ]; then
        echo -e "${GREEN}OK (no code files changed)${NC}"
    else
        # shellcheck disable=SC2086
        if uvx --quiet semgrep scan --config=p/security-audit --severity=ERROR --error --quiet $CHANGED_FILES >/tmp/semgrep-pre-push.log 2>&1; then
            echo -e "${GREEN}OK${NC}"
        else
            echo -e "${RED}FAILED${NC}"
            echo "  Semgrep ERROR-severity findings on changed files:"
            cat /tmp/semgrep-pre-push.log
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# CHECK 9: Plan/audit drift detector (warning only — surface ghost refs)
echo -n "Checking plan/audit drift... "
if [ -z "$PY_BIN" ]; then
    echo -e "${YELLOW}SKIPPED (no python)${NC}"
elif [ ! -f "scripts/check_plan_drift.py" ]; then
    echo -e "${YELLOW}SKIPPED (detector missing)${NC}"
else
    DRIFT_OUT="$("$PY_BIN" scripts/check_plan_drift.py 2>&1 || true)"
    if echo "$DRIFT_OUT" | grep -q "^OK:"; then
        echo -e "${GREEN}OK${NC}"
    else
        DRIFT_LINE=$(echo "$DRIFT_OUT" | grep -E "^DRIFT:" | head -1)
        echo -e "${YELLOW}WARNING${NC}"
        echo "  $DRIFT_LINE"
        echo "  Run: $PY_BIN scripts/check_plan_drift.py"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# CHECK 7: Widget file sync (warning only)
echo -n "Checking widget file sync... "
if [ -f "widget/agentnexlify-widget.js" ] && [ -f "frontend/public/widget/agentnexlify-widget.js" ]; then
    if diff -q "widget/agentnexlify-widget.js" "frontend/public/widget/agentnexlify-widget.js" > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${YELLOW}WARNING${NC}"
        echo "  widget/ and frontend/public/widget/ versions differ."
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo -e "${YELLOW}SKIPPED (widget files not found)${NC}"
fi

echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}PUSH BLOCKED: $ERRORS critical issue(s) found.${NC}"
    echo "Fix the issues above before pushing."
    echo "To bypass in an emergency: git push --no-verify"
    exit 1
fi

if [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}$WARNINGS warning(s) found.${NC}"
fi

echo -e "${GREEN}All pre-push checks passed.${NC}"
