#!/usr/bin/env bash
# AgentNexLiFy pre-push hook
# Runs deploy-check before pushing to remote
# Install: bash scripts/install-hooks.sh

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0

echo "Running AgentNexLiFy pre-push checks..."
echo ""

# CHECK 1: Frontend build
echo -n "Checking frontend build... "
if [ -d "frontend" ]; then
    if (cd frontend && npm run build --silent 2>/dev/null); then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        echo "  Frontend build failed. Fix build errors before pushing."
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${YELLOW}SKIPPED (no frontend dir found)${NC}"
fi

# CHECK 2: Backend imports (warning only — may fail if deps not installed locally)
echo -n "Checking backend imports... "
if [ -d "backend" ]; then
    if python -c "import sys; sys.path.insert(0, '.'); from backend.main import app" 2>/dev/null; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${YELLOW}SKIPPED (dependencies not available locally)${NC}"
    fi
else
    echo -e "${YELLOW}SKIPPED (no backend dir found)${NC}"
fi

# CHECK 3: Full repo scan for dangerous patterns (exclude comments)
echo -n "Scanning for __future__ annotations in routers... "
if grep -rn "from __future__ import annotations" backend/routers/ 2>/dev/null | grep -v "^.*:#" | grep -q .; then
    echo -e "${RED}FAILED${NC}"
    echo "  from __future__ import annotations found in router files — this breaks FastAPI"
    grep -rn "from __future__ import annotations" backend/routers/ 2>/dev/null | grep -v "^.*:#"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 4: Schema consistency — leads table should use client_id and status
echo -n "Checking for known schema mismatches... "
MISMATCHES=0
# Check if leads queries incorrectly use lead_stage (should be status)
if grep -rn "lead_stage" backend/ --include="*.py" 2>/dev/null | grep -v "#" | grep -v "trigger_event" | grep -q .; then
    echo ""
    echo -e "  ${YELLOW}WARNING: Found lead_stage references (should be status for leads table)${NC}"
    MISMATCHES=$((MISMATCHES + 1))
fi
if [ $MISMATCHES -eq 0 ]; then
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 5: .env in .gitignore
echo -n "Checking .gitignore includes .env... "
if grep -q "\.env" .gitignore 2>/dev/null; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAILED${NC}"
    echo "  .env is NOT in .gitignore!"
    ERRORS=$((ERRORS + 1))
fi

# CHECK 6: Widget file sync
echo -n "Checking widget file sync... "
if [ -f "widget/agentnexlify-widget.js" ] && [ -f "frontend/public/widget/agentnexlify-widget.js" ]; then
    if diff -q "widget/agentnexlify-widget.js" "frontend/public/widget/agentnexlify-widget.js" > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${YELLOW}WARNING${NC}"
        echo "  widget/agentnexlify-widget.js and frontend/public/widget/agentnexlify-widget.js are out of sync!"
        MISMATCHES=$((MISMATCHES + 1))
    fi
else
    echo -e "${YELLOW}SKIPPED (widget files not found)${NC}"
fi

echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}PUSH BLOCKED: $ERRORS critical issue(s) found.${NC}"
    echo "Fix the issues above before pushing."
    echo "To bypass in an emergency: git push --no-verify"
    exit 1
else
    echo -e "${GREEN}All pre-push checks passed.${NC}"
fi
