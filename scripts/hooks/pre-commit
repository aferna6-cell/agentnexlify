#!/usr/bin/env bash
# AgentNexLiFy pre-commit hook
# Blocks commits that contain known dangerous patterns
# Install: bash scripts/install-hooks.sh

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

echo "Running AgentNexLiFy pre-commit checks..."
echo ""

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No staged files to check.${NC}"
    exit 0
fi

# CHECK 1: Hardcoded secrets
echo -n "Checking for hardcoded secrets... "
SECRET_PATTERNS="sk_live_|sk_test_|ANTHROPIC_API_KEY.*=.*sk-ant|supabase.*eyJ|password.*=.*['\"][^'\"]{20}"
SECRETS_FOUND=""
for file in $STAGED_FILES; do
    if [[ "$file" == *.py || "$file" == *.ts || "$file" == *.tsx || "$file" == *.js || "$file" == *.jsx ]]; then
        if [ -f "$file" ]; then
            MATCH=$(grep -nE "$SECRET_PATTERNS" "$file" 2>/dev/null || true)
            if [ -n "$MATCH" ]; then
                SECRETS_FOUND="$SECRETS_FOUND\n  $file: $MATCH"
            fi
        fi
    fi
done
if [ -n "$SECRETS_FOUND" ]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  Possible secrets detected:${SECRETS_FOUND}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 2: from __future__ import annotations in router files
echo -n "Checking for dangerous __future__ imports... "
FUTURE_FOUND=""
for file in $STAGED_FILES; do
    if [[ "$file" == *routers*.py || "$file" == *router*.py ]]; then
        if [ -f "$file" ]; then
            MATCH=$(grep -n "from __future__ import annotations" "$file" 2>/dev/null | grep -v "^[0-9]*:[[:space:]]*#" || true)
            if [ -n "$MATCH" ]; then
                FUTURE_FOUND="$FUTURE_FOUND\n  $file:$MATCH"
            fi
        fi
    fi
done
if [ -n "$FUTURE_FOUND" ]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  This WILL break all FastAPI request parsing:${FUTURE_FOUND}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 3: Bare except blocks and dangerous BaseException catches
echo -n "Checking for silent exception swallowing... "
BARE_FOUND=""
for file in $STAGED_FILES; do
    if [[ "$file" == *.py ]]; then
        if [ -f "$file" ]; then
            MATCH=$(grep -n "except.*:.*pass\|except:$" "$file" 2>/dev/null || true)
            if [ -n "$MATCH" ]; then
                BARE_FOUND="$BARE_FOUND\n  $file:$MATCH"
            fi
        fi
    fi
done
if [ -n "$BARE_FOUND" ]; then
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "  Bare except blocks hide real errors:${BARE_FOUND}"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 3b: except BaseException (prevents graceful shutdown)
echo -n "Checking for BaseException catches... "
BASE_FOUND=""
for file in $STAGED_FILES; do
    if [[ "$file" == *.py ]]; then
        if [ -f "$file" ]; then
            MATCH=$(grep -n "except BaseException" "$file" 2>/dev/null | grep -v "^[0-9]*:[[:space:]]*#" || true)
            if [ -n "$MATCH" ]; then
                BASE_FOUND="$BASE_FOUND\n  $file:$MATCH"
            fi
        fi
    fi
done
if [ -n "$BASE_FOUND" ]; then
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "  except BaseException catches SystemExit/KeyboardInterrupt — use except Exception:${BASE_FOUND}"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 4: .env files being committed
echo -n "Checking for .env files... "
ENV_FILES=""
for file in $STAGED_FILES; do
    if [[ "$file" == .env.example || "$file" == */.env.example ]]; then
        continue
    fi
    if [[ "$file" == .env* || "$file" == */.env* ]]; then
        ENV_FILES="$ENV_FILES $file"
    fi
done
if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}BLOCKED${NC}"
    echo "  Never commit .env files:$ENV_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 5: Migration file numbering
echo -n "Checking migration numbering... "
STAGED_MIGRATIONS=""
for file in $STAGED_FILES; do
    if [[ "$file" == migrations/*.sql ]]; then
        STAGED_MIGRATIONS="$STAGED_MIGRATIONS $file"
    fi
done
if [ -n "$STAGED_MIGRATIONS" ]; then
    DUPE_NUMS=$(ls migrations/*.sql 2>/dev/null | sed 's/.*\///' | grep -oP '^\d+' | sort | uniq -d)
    if [ -n "$DUPE_NUMS" ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo "  Duplicate migration numbers found: $DUPE_NUMS"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK (no migrations staged)${NC}"
fi

# CHECK 6: JS/TS test quality gates (custom ESLint rules)
echo -n "Checking JS/TS test quality... "
STAGED_TEST_FILES=$(echo "$STAGED_FILES" | grep -E "(^|/)(__tests__/.*\.(js|jsx|ts|tsx)$|.*\.(test|spec)\.(js|jsx|ts|tsx)$)" || true)
if [ -n "$STAGED_TEST_FILES" ]; then
    if command -v node >/dev/null 2>&1; then
        if node scripts/lint-test-quality-staged.cjs; then
            echo -e "${GREEN}OK${NC}"
        else
            echo -e "${RED}BLOCKED${NC}"
            echo "  JS/TS test quality lint failed. Fix issues above before committing."
            ERRORS=$((ERRORS + 1))
        fi
    else
        echo -e "${RED}BLOCKED${NC}"
        echo "  Node.js is required to lint staged JS/TS tests."
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${GREEN}OK (no JS/TS tests staged)${NC}"
fi

# CHECK 7: Python test quality gates
echo -n "Checking Python test quality... "
STAGED_PY_TEST_FILES=$(echo "$STAGED_FILES" | grep -E "(^|/)(tests/.*\\.py|test_.*\\.py)$" || true)
if [ -n "$STAGED_PY_TEST_FILES" ]; then
    PY_BIN=""
    if command -v python3 >/dev/null 2>&1; then
        PY_BIN="python3"
    elif command -v python >/dev/null 2>&1; then
        PY_BIN="python"
    fi

    if [ -z "$PY_BIN" ]; then
        echo -e "${RED}BLOCKED${NC}"
        echo "  Python is required to lint staged Python tests."
        ERRORS=$((ERRORS + 1))
    elif $PY_BIN scripts/lint_python_test_quality.py $STAGED_PY_TEST_FILES; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}BLOCKED${NC}"
        echo "  Python test-quality lint failed. Fix issues above before committing."
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${GREEN}OK (no Python tests staged)${NC}"
fi

echo ""

# CHECK 8: Dropped schema columns referenced in queries
# conversations.messages JSONB was removed in the reconciliation migration —
# the canonical message store is chat_messages. Any new .select("messages") or
# dict-shape query against the conversations table will 42703 in prod.
echo -n "Checking for dropped conversations.messages queries... "
DROPPED_COL_HITS=""
for file in $STAGED_FILES; do
    if [[ "$file" == *.py ]] && [ -f "$file" ]; then
        MATCH=$(grep -nE 'table\(["'\'']conversations["'\'']\)[^.]*\.\s*select\(["'\''][^"'\'']*messages' "$file" 2>/dev/null || true)
        if [ -n "$MATCH" ]; then
            DROPPED_COL_HITS="$DROPPED_COL_HITS\n  $file: $MATCH"
        fi
    fi
done
if [ -n "$DROPPED_COL_HITS" ]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  conversations.messages column was dropped. Query chat_messages by session_id instead.${DROPPED_COL_HITS}"
    echo "  See docs/dev-knowledge/bug-patterns.md entry dated 2026-04-13."
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# CHECK 9: JS silent catch — .catch(() => null) / .catch(() => {})
echo -n "Check 9: JS silent catch guard... "
JS_STAGED=$(git diff --cached --name-only | grep -E '\.(js|jsx)$' || true)
SILENT_CATCH_HITS=""
if [ -n "$JS_STAGED" ]; then
    for f in $JS_STAGED; do
        if [ -f "$f" ]; then
            hits=$(grep -nE '\.catch\(\s*\(\s*\)\s*=>\s*(null|\{\s*\})\s*\)' "$f" \
                   | grep -v "ok-silent-catch" || true)
            if [ -n "$hits" ]; then
                SILENT_CATCH_HITS="$SILENT_CATCH_HITS\n  $f:\n$hits"
            fi
        fi
    done
fi
if [ -n "$SILENT_CATCH_HITS" ]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  Silent .catch found — exceptions swallowed without logging.$SILENT_CATCH_HITS"
    echo "  Fix: log the error, or add '// ok-silent-catch' if intentional graceful degradation."
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# Check 10: Project invariants (widget sync, schema fields, em-dash, future-annotations)
echo -n "Check 10: project invariants... "
if python3 scripts/check_project_invariants.py > /tmp/invariant_out 2>&1; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}BLOCKED${NC}"
    cat /tmp/invariant_out | sed 's/^/  /'
    echo "  Fix invariant violations above before committing."
    ERRORS=$((ERRORS + 1))
fi

# Check 11: Billing constant guard
echo -n "Check 11: Billing constant guard... "
BILLING_FILE="backend/routers/billing.py"
if [ -f "$BILLING_FILE" ]; then
    REQUIRED_AMOUNTS=(9900 15000 25000 89900)
    MISSING_AMOUNTS=()
    for amt in "${REQUIRED_AMOUNTS[@]}"; do
        if ! grep -qP "^\s+${amt}:" "$BILLING_FILE"; then
            MISSING_AMOUNTS+=("$amt")
        fi
    done
    if [ ${#MISSING_AMOUNTS[@]} -gt 0 ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo "  AMOUNT_TO_PLAN in $BILLING_FILE missing entries: ${MISSING_AMOUNTS[*]}"
        echo "  Expected: 9900 (growth), 15000 (autopilot), 25000 (professional), 89900 (enterprise)"
        echo "  Fix: backend/routers/billing.py — see GH #181"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
fi

# Check 12: agent-service timing-safe comparison guard
echo -n "Check 12: agent-service timing-safe comparison guard... "
if [ -d "agent-service/src" ]; then
    TIMING_HITS=$(grep -rE "(token|secret|key|header)[a-zA-Z]* ===" agent-service/src/ --include="*.ts" | \
        grep -v "timingSafeEqual" | grep -v "// ok-timing-unsafe" || true)
    if [ -n "$TIMING_HITS" ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo "  agent-service may have timing-unsafe token comparisons. Use timingSafeEqual from node:crypto."
        echo "  Hits:"
        echo "$TIMING_HITS" | head -5 | sed 's/^/    /'
        echo "  Fix: import { timingSafeEqual } from 'node:crypto'"
        echo "  Bypass: add '// ok-timing-unsafe' comment on the line if intentional"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK${NC} (agent-service/src not present, skipped)"
fi

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}COMMIT BLOCKED: $ERRORS critical issue(s) found.${NC}"
    echo "Fix the issues above before committing."
    echo "To bypass in an emergency: git commit --no-verify"
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}$WARNINGS warning(s) found. Committing anyway.${NC}"
    echo "Consider fixing these before pushing."
fi
