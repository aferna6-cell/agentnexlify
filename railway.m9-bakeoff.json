{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.m9-bakeoff"
  },
  "deploy": {
    "startCommand": "python -m backend.services.os_workflows.run_live_bakeoff",
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0
  }
}
