{
  "name": "agentnexlify-agent-service",
  "version": "1.0.0",
  "description": "HTTP layer for the FastAPI backend. Wraps @anthropic-ai/claude-agent-sdk (POST /agents/:name/run) and hosts the Agent OS engine (src/agent-os) as the orchestration core. src/agent-os is the SOURCE OF TRUTH for the engine - the old standalone Agent-Nexlify-OS repo was transferred into this one and is stale.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "eval:actions": "node --experimental-strip-types evals/run-action-eval.ts",
    "eval:actions:gate": "node --experimental-strip-types evals/run-action-eval.ts --gate",
    "eval:bakeoff": "node --experimental-strip-types evals/run-router-bakeoff.ts",
    "vendor:agent-os": "bash scripts/vendor-agent-os.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.110",
    "@anthropic-ai/sdk": "^0.100.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
