{
  "name": "agentnexlify-agent-service",
  "version": "1.0.0",
  "description": "HTTP layer for the FastAPI backend. Wraps @anthropic-ai/claude-agent-sdk (POST /agents/:name/run) and hosts the Agent OS engine (src/agent-os) as the orchestration core. src/agent-os is the SOURCE OF TRUTH for the engine - the old standalone Agent-Nexlify-OS repo was transferred into this one and is stale.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "vendor:agent-os": "bash scripts/vendor-agent-os.sh",
    "eval:actions": "node --experimental-strip-types evals/run-action-eval.ts",
    "eval:actions:gate": "node --experimental-strip-types evals/run-action-eval.ts --gate",
    "eval:export-llm": "node --experimental-strip-types evals/export-llm-predictions.ts",
    "eval:export-heuristic": "node --experimental-strip-types evals/export-heuristic-predictions.ts",
    "eval:errors": "node --experimental-strip-types evals/analyze-errors.ts --dataset evals/datasets/validation/validation-v2.json",
    "eval:inspect": "node --experimental-strip-types evals/inspect.ts",
    "eval:validation": "node --experimental-strip-types evals/run-action-eval.ts --dataset evals/datasets/validation/validation-v2.json --report",
    "eval:validation:v1": "node --experimental-strip-types evals/run-action-eval.ts --dataset evals/datasets/validation/validation-v1.json --report",
    "eval:validation:v3": "node --experimental-strip-types evals/run-action-eval.ts --dataset evals/datasets/validation/validation-v3.json --report",
    "eval:rag": "python3 ../ml/rag/evaluate.py",
    "eval:rag:holdout": "python3 ../ml/rag/evaluate.py --dataset evals/datasets/rag/rag-eval-holdout-v1.json",
    "eval:rag:calibrate": "python3 ../ml/rag/calibrate_abstention.py",
    "eval:rag:downstream": "python3 ../ml/rag/downstream_bakeoff.py"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.110",
    "@anthropic-ai/sdk": "^0.100.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
